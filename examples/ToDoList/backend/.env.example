# ToDoList Backend Configuration
# Copy this file to `.env` before running locally and set a strong JWT_SECRET (>= 32 chars).

APP_ENV=development
PORT=8080
TODOLIST_DB_PATH=data/todolist.db

# REQUIRED: Minimum 32 characters. Server refuses to start if missing or shorter than 32 bytes.
JWT_SECRET=change-this-development-secret-to-32-plus-characters
JWT_TTL_SECONDS=86400

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000

# Fixed-window rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
