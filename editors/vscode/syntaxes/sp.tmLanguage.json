{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SP",
  "scopeName": "source.sp",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.documentation.sp",
          "match": "///.*$"
        },
        {
          "name": "comment.block.documentation.sp",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.sp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sp",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sp",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sp",
              "match": "\\\\([nrtvfb\"'\\\\]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            },
            {
              "name": "punctuation.definition.template-expression.sp",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.sp",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sp",
          "match": "\\b0[xX][0-9a-fA-F]+(_[0-9a-fA-F]+)*\\b"
        },
        {
          "name": "constant.numeric.binary.sp",
          "match": "\\b0[bB][01]+(_[01]+)*\\b"
        },
        {
          "name": "constant.numeric.float.sp",
          "match": "\\b\\d+(_\\d+)*\\.\\d+(_\\d+)*([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.sp",
          "match": "\\b\\d+(_\\d+)*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sp",
          "match": "\\b(if|else|while|for|in|return|match|switch|case|default|break|continue|try|catch|finally|throw)\\b"
        },
        {
          "name": "storage.type.sp",
          "match": "\\b(fn|let|const|var|class|interface|struct|enum|type|import|module)\\b"
        },
        {
          "name": "storage.modifier.sp",
          "match": "\\b(public|private|protected|static|override|abstract|async|await|extends|implements)\\b"
        },
        {
          "name": "keyword.other.sp",
          "match": "\\b(test|assert|new)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.sp",
          "match": "\\b(int|float|string|bool|char|byte|void|any)\\b"
        },
        {
          "name": "entity.name.type.collection.sp",
          "match": "\\b(Array|Map|List|Set)\\b"
        },
        {
          "name": "entity.name.type.class.sp",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.sp" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.sp",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.range.sp",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.sp",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.sp",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.nullsafe.sp",
          "match": "(\\?\\.|\\?\\?|\\?)"
        },
        {
          "name": "keyword.operator.assignment.sp",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.sp",
          "match": "(\\+\\+|--|\\+|-|\\*|/|%)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sp",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.sp",
          "match": "\\bnull\\b"
        }
      ]
    }
  }
}
