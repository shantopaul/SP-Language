# ==============================================================================
# Cloudflare R2 Credentials for SP Language Release Distribution
# ==============================================================================
# Copy this file to .env and fill in your Access Key ID and Secret Access Key.
# DO NOT commit .env to version control!
#
# Get credentials from:
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create Account API token
# Permissions: Object Read & Write
# ==============================================================================

R2_ACCOUNT_ID=3b56f1445438ff6041fee436fe29b097
R2_BUCKET_NAME=splang-releases
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
